diff --git a/frontend/src/lib/nutrition.js b/frontend/src/lib/nutrition.js
new file mode 100644
index 00000000..6e5fd480
--- /dev/null
+++ b/frontend/src/lib/nutrition.js
@@ -0,0 +1,188 @@
+// Nutrition counter: calories, protein and water per day.
+//
+// Kept on this device only, under its own localStorage key (store/useNutrition.js), so it is not
+// part of the synced profile (S): the sync merge and the server never see it. Everything here is a
+// pure helper that returns a new object and never edits its input, with a unit test beside it.
+//
+// Shape:
+//   { v: 1,
+//     targets: { kcal, protein, water },            // water in millilitres
+//     foods:   [{ id, name, kcal, protein }],        // saved foods for one-tap adding
+//     days:    { 'YYYY-MM-DD': { entries: [{ id, name, kcal, protein }], water } } }
+import { dateLocale } from './i18n-core.js'
+import { isoOf, uid } from './format.js'
+
+export const NUTRITION_KEY = 'gym_nutrition_v1'
+export const DEFAULT_TARGETS = { kcal: 2300, protein: 130, water: 2500 }
+// [min, max] a target may be set to.
+export const TARGET_LIMITS = { kcal: [800, 6000], protein: [20, 400], water: [500, 8000] }
+
+const MAX_FOODS = 60
+const MAX_ENTRIES = 100
+const MAX_DAYS = 400
+const MAX_NAME = 60
+const MAX_WATER = 20000
+const ISO = /^\d{4}-\d{2}-\d{2}$/
+
+// A finite number clamped to [lo, hi] and rounded to `dp` decimals; null for anything else.
+function num(v, lo, hi, dp = 0) {
+  if (v === '' || v == null || typeof v === 'boolean') return null
+  const n = Number(v)
+  if (!Number.isFinite(n)) return null
+  const f = 10 ** dp
+  return Math.round(Math.min(hi, Math.max(lo, n)) * f) / f
+}
+const cleanName = s => String(s ?? '').replace(/\s+/g, ' ').trim().slice(0, MAX_NAME)
+
+export const emptyNutrition = () => ({ v: 1, targets: { ...DEFAULT_TARGETS }, foods: [], days: {} })
+
+function normalizeFood(f, i) {
+  if (!f || typeof f !== 'object') return null
+  const name = cleanName(f.name)
+  const kcal = num(f.kcal, 0, 5000)
+  const protein = num(f.protein ?? 0, 0, 500, 1)
+  if (!name || kcal == null || protein == null) return null
+  return { id: typeof f.id === 'string' && f.id ? f.id : 'f' + i, name, kcal, protein }
+}
+function normalizeEntry(e, i) {
+  if (!e || typeof e !== 'object') return null
+  const kcal = num(e.kcal, 0, 5000)
+  const protein = num(e.protein ?? 0, 0, 500, 1)
+  if (kcal == null || protein == null) return null
+  return { id: typeof e.id === 'string' && e.id ? e.id : 'e' + i, name: cleanName(e.name), kcal, protein }
+}
+
+// Whatever was stored or imported, turned into a valid state: junk is dropped, numbers are
+// clamped, caps keep the file small. Never throws.
+export function normalizeNutrition(raw) {
+  const out = emptyNutrition()
+  if (!raw || typeof raw !== 'object') return out
+  const tg = raw.targets && typeof raw.targets === 'object' ? raw.targets : {}
+  for (const k of Object.keys(DEFAULT_TARGETS)) {
+    const [lo, hi] = TARGET_LIMITS[k]
+    out.targets[k] = num(tg[k], lo, hi) ?? DEFAULT_TARGETS[k]
+  }
+  const seen = new Set()
+  const foods = Array.isArray(raw.foods) ? raw.foods : []
+  for (let i = 0; i < foods.length && out.foods.length < MAX_FOODS; i++) {
+    const food = normalizeFood(foods[i], i)
+    if (!food || seen.has(food.name.toLowerCase())) continue
+    seen.add(food.name.toLowerCase())
+    out.foods.push(food)
+  }
+  const days = raw.days && typeof raw.days === 'object' ? raw.days : {}
+  for (const iso of Object.keys(days).filter(k => ISO.test(k)).sort().slice(-MAX_DAYS)) {
+    const d = days[iso]
+    if (!d || typeof d !== 'object') continue
+    const entries = (Array.isArray(d.entries) ? d.entries : []).map(normalizeEntry).filter(Boolean).slice(0, MAX_ENTRIES)
+    const water = num(d.water, 0, MAX_WATER) ?? 0
+    if (entries.length || water) out.days[iso] = { entries, water }
+  }
+  return out
+}
+
+export const dayOf = (N, iso) => N.days[iso] || { entries: [], water: 0 }
+
+export function dayTotals(day) {
+  let kcal = 0
+  let protein = 0
+  for (const e of day.entries) { kcal += e.kcal; protein += e.protein }
+  return { kcal: Math.round(kcal), protein: Math.round(protein * 10) / 10, water: day.water || 0, count: day.entries.length }
+}
+
+// The day with `fn` applied to it; a day left with nothing in it is dropped from the file.
+function withDay(N, iso, fn) {
+  const day = dayOf(N, iso)
+  const next = fn({ entries: day.entries, water: day.water || 0 })
+  const days = { ...N.days }
+  if (next.entries.length || next.water) days[iso] = next
+  else delete days[iso]
+  return { ...N, days }
+}
+
+// A food eaten on `iso`. Returns N itself when the input is not usable, so callers can tell
+// nothing changed. The name may be empty: "200 kcal" is a fair entry.
+export function addEntry(N, iso, { name, kcal, protein }, id = uid()) {
+  const k = num(kcal, 0, 5000)
+  const p = num(protein ?? 0, 0, 500, 1)
+  if (!ISO.test(iso) || k == null || p == null || (k === 0 && p === 0)) return N
+  if (dayOf(N, iso).entries.length >= MAX_ENTRIES) return N
+  return withDay(N, iso, d => ({ ...d, entries: [...d.entries, { id, name: cleanName(name), kcal: k, protein: p }] }))
+}
+
+export const removeEntry = (N, iso, id) => withDay(N, iso, d => ({ ...d, entries: d.entries.filter(e => e.id !== id) }))
+
+// Water in millilitres, added or (negative) taken back; never below 0.
+export function addWater(N, iso, ml) {
+  const n = Number(ml)
+  if (!ISO.test(iso) || !Number.isFinite(n)) return N
+  return withDay(N, iso, d => ({ ...d, water: Math.min(MAX_WATER, Math.max(0, Math.round(d.water + n))) }))
+}
+
+// Saves a food for one-tap adding. The same name (any case) updates the saved one.
+export function saveFood(N, { name, kcal, protein }, id = uid()) {
+  const food = normalizeFood({ id, name, kcal, protein }, 0)
+  if (!food) return N
+  const i = N.foods.findIndex(f => f.name.toLowerCase() === food.name.toLowerCase())
+  if (i >= 0) {
+    const foods = N.foods.slice()
+    foods[i] = { ...food, id: N.foods[i].id }
+    return { ...N, foods }
+  }
+  if (N.foods.length >= MAX_FOODS) return N
+  return { ...N, foods: [...N.foods, food] }
+}
+
+export const removeFood = (N, id) => ({ ...N, foods: N.foods.filter(f => f.id !== id) })
+
+// Only the targets that are usable change; the rest keep their value.
+export function setTargets(N, next) {
+  const targets = { ...N.targets }
+  for (const k of Object.keys(DEFAULT_TARGETS)) {
+    const [lo, hi] = TARGET_LIMITS[k]
+    const v = num(next?.[k], lo, hi)
+    if (v != null) targets[k] = v
+  }
+  return { ...N, targets }
+}
+
+export function addDays(iso, n) {
+  const d = new Date(iso + 'T12:00:00')
+  d.setDate(d.getDate() + n)
+  return isoOf(d)
+}
+
+// The `n` days ending at `endIso`, oldest first, each with its totals (empty days included).
+export function recentDays(N, endIso, n = 7) {
+  const out = []
+  for (let i = n - 1; i >= 0; i--) {
+    const d = addDays(endIso, -i)
+    out.push({ d, ...dayTotals(dayOf(N, d)) })
+  }
+  return out
+}
+
+// Average calories and protein over the days that have food logged; null when there are none.
+export function averageLogged(rows) {
+  const logged = rows.filter(r => r.count > 0)
+  if (!logged.length) return null
+  const sum = key => logged.reduce((a, r) => a + r[key], 0) / logged.length
+  return { days: logged.length, kcal: Math.round(sum('kcal')), protein: Math.round(sum('protein') * 10) / 10 }
+}
+
+// How full a bar is, 0 to 100, and whether the value is past the target.
+export const barPct = (value, target) => (target > 0 ? Math.min(100, Math.round((Math.max(0, value) / target) * 100)) : 0)
+export const overTarget = (value, target) => target > 0 && value > target
+
+// Millilitres as litres in the UI language: 1250 reads "1.25" or "1,25", not a rounded "1.3".
+export const fmtLiters = ml => new Intl.NumberFormat(dateLocale(), { maximumFractionDigits: 2 }).format(ml / 1000)
+
+export const exportNutrition = N => JSON.stringify(N, null, 2)
+
+// Text from a backup file back into a state. Throws when it is not a JSON object, so the caller
+// can say so instead of wiping the data with an empty one.
+export function importNutrition(text) {
+  const raw = JSON.parse(text)
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) throw new Error('not a nutrition backup')
+  return normalizeNutrition(raw)
+}
diff --git a/frontend/src/lib/nutrition.test.js b/frontend/src/lib/nutrition.test.js
new file mode 100644
index 00000000..09f021e7
--- /dev/null
+++ b/frontend/src/lib/nutrition.test.js
@@ -0,0 +1,202 @@
+import { describe, expect, it } from 'vitest'
+import {
+  DEFAULT_TARGETS, addDays, addEntry, addWater, averageLogged, barPct, dayOf, dayTotals, emptyNutrition,
+  exportNutrition, fmtLiters, importNutrition, normalizeNutrition, overTarget, recentDays, removeEntry,
+  removeFood, saveFood, setTargets,
+} from './nutrition.js'
+
+const D = '2026-10-26'
+
+describe('normalizeNutrition', () => {
+  it('turns nothing, junk and the wrong type into an empty counter with the default targets', () => {
+    for (const raw of [null, undefined, 'x', 5, [], {}]) {
+      expect(normalizeNutrition(raw)).toEqual({ v: 1, targets: DEFAULT_TARGETS, foods: [], days: {} })
+    }
+  })
+
+  it('keeps good data, clamps numbers and drops what cannot be read', () => {
+    const N = normalizeNutrition({
+      targets: { kcal: 99999, protein: 'abc', water: 3000 },
+      foods: [
+        { id: 'a', name: '  Egg ', kcal: 78, protein: 6.26 },
+        { id: 'b', name: 'egg', kcal: 1, protein: 1 },      // same name, any case
+        { id: 'c', name: '', kcal: 10 },                      // no name
+        { id: 'd', name: 'Bad', kcal: 'many' },               // no calories
+        null,
+      ],
+      days: {
+        [D]: { entries: [{ id: 'x', name: 'Rice', kcal: 200, protein: 4 }, { kcal: -5 }, 'junk'], water: 1250.4 },
+        'not-a-date': { entries: [{ kcal: 1 }], water: 1 },
+        '2026-10-25': { entries: [], water: 0 },             // nothing in it
+      },
+    })
+    expect(N.targets).toEqual({ kcal: 6000, protein: DEFAULT_TARGETS.protein, water: 3000 })
+    expect(N.foods).toEqual([{ id: 'a', name: 'Egg', kcal: 78, protein: 6.3 }])
+    expect(Object.keys(N.days)).toEqual([D])
+    expect(N.days[D].water).toBe(1250)
+    // the negative calorie value is clamped to 0, which is still a readable entry
+    expect(N.days[D].entries.map(e => e.name)).toEqual(['Rice', ''])
+  })
+
+  it('survives a round trip through JSON', () => {
+    let N = emptyNutrition()
+    N = addEntry(N, D, { name: 'Yogurt', kcal: 120, protein: 10 }, 'e1')
+    N = addWater(N, D, 500)
+    N = saveFood(N, { name: 'Yogurt', kcal: 120, protein: 10 }, 'f1')
+    expect(normalizeNutrition(JSON.parse(JSON.stringify(N)))).toEqual(N)
+  })
+})
+
+describe('entries', () => {
+  it('adds up calories and protein for the day', () => {
+    let N = emptyNutrition()
+    N = addEntry(N, D, { name: 'Eggs', kcal: 156, protein: 12.5 }, 'a')
+    N = addEntry(N, D, { name: 'Ayran', kcal: 60, protein: 3.2 }, 'b')
+    expect(dayTotals(dayOf(N, D))).toEqual({ kcal: 216, protein: 15.7, water: 0, count: 2 })
+  })
+
+  it('does not change the old state', () => {
+    const N = emptyNutrition()
+    const next = addEntry(N, D, { name: 'x', kcal: 10 }, 'a')
+    expect(N.days).toEqual({})
+    expect(next).not.toBe(N)
+  })
+
+  it('refuses an empty or unreadable entry and returns the same object', () => {
+    const N = emptyNutrition()
+    expect(addEntry(N, D, { name: 'x', kcal: 0, protein: 0 })).toBe(N)
+    expect(addEntry(N, D, { name: 'x', kcal: 'abc' })).toBe(N)
+    expect(addEntry(N, 'yesterday', { name: 'x', kcal: 100 })).toBe(N)
+  })
+
+  it('accepts protein without calories and a name that is empty', () => {
+    const N = addEntry(emptyNutrition(), D, { name: '  ', kcal: 0, protein: 25 }, 'a')
+    expect(N.days[D].entries).toEqual([{ id: 'a', name: '', kcal: 0, protein: 25 }])
+  })
+
+  it('removes an entry and drops the day once nothing is left', () => {
+    let N = addEntry(emptyNutrition(), D, { name: 'x', kcal: 100 }, 'a')
+    N = addEntry(N, D, { name: 'y', kcal: 50 }, 'b')
+    N = removeEntry(N, D, 'a')
+    expect(N.days[D].entries.map(e => e.id)).toEqual(['b'])
+    N = removeEntry(N, D, 'b')
+    expect(N.days).toEqual({})
+  })
+})
+
+describe('water', () => {
+  it('adds and takes back, never below zero or above the cap', () => {
+    let N = addWater(emptyNutrition(), D, 250)
+    N = addWater(N, D, 500)
+    expect(dayOf(N, D).water).toBe(750)
+    N = addWater(N, D, -1000)
+    expect(N.days[D]).toBeUndefined()   // back to nothing: the day leaves the file
+    N = addWater(N, D, 99999)
+    expect(dayOf(N, D).water).toBe(20000)
+  })
+
+  it('ignores a bad amount or date', () => {
+    const N = emptyNutrition()
+    expect(addWater(N, D, NaN)).toBe(N)
+    expect(addWater(N, 'x', 250)).toBe(N)
+  })
+
+  it('keeps water and food of one day together', () => {
+    let N = addWater(emptyNutrition(), D, 250)
+    N = addEntry(N, D, { name: 'x', kcal: 100 }, 'a')
+    N = removeEntry(N, D, 'a')
+    expect(dayOf(N, D).water).toBe(250)
+  })
+})
+
+describe('saved foods and targets', () => {
+  it('saves a food once per name and updates it in place', () => {
+    let N = saveFood(emptyNutrition(), { name: 'Egg', kcal: 78, protein: 6 }, 'a')
+    N = saveFood(N, { name: 'EGG', kcal: 80, protein: 6.5 }, 'b')
+    expect(N.foods).toEqual([{ id: 'a', name: 'EGG', kcal: 80, protein: 6.5 }])
+  })
+
+  it('refuses a food without a name or calories, and removes by id', () => {
+    const N = emptyNutrition()
+    expect(saveFood(N, { name: '', kcal: 10 })).toBe(N)
+    expect(saveFood(N, { name: 'x' })).toBe(N)
+    const one = saveFood(N, { name: 'x', kcal: 10 }, 'a')
+    expect(removeFood(one, 'a').foods).toEqual([])
+  })
+
+  it('changes the targets that are usable and keeps the rest', () => {
+    const N = setTargets(emptyNutrition(), { kcal: 2100, protein: '', water: 'lots' })
+    expect(N.targets).toEqual({ kcal: 2100, protein: DEFAULT_TARGETS.protein, water: DEFAULT_TARGETS.water })
+    expect(setTargets(N, { kcal: 10 }).targets.kcal).toBe(800)
+  })
+})
+
+describe('the week', () => {
+  it('addDays crosses months and years', () => {
+    expect(addDays('2026-10-31', 1)).toBe('2026-11-01')
+    expect(addDays('2026-01-01', -1)).toBe('2025-12-31')
+    expect(addDays('2026-03-01', -1)).toBe('2026-02-28')
+  })
+
+  it('addDays is not thrown off by a clock change', () => {
+    expect(addDays('2026-03-28', 1)).toBe('2026-03-29')
+    expect(addDays('2026-03-29', 1)).toBe('2026-03-30')
+    expect(addDays('2026-10-24', 1)).toBe('2026-10-25')
+    expect(addDays('2026-10-25', 1)).toBe('2026-10-26')
+  })
+
+  it('lists the last days oldest first, empty days included', () => {
+    let N = addEntry(emptyNutrition(), '2026-10-24', { name: 'x', kcal: 500, protein: 30 }, 'a')
+    N = addEntry(N, D, { name: 'y', kcal: 700, protein: 40 }, 'b')
+    const rows = recentDays(N, D, 4)
+    expect(rows.map(r => r.d)).toEqual(['2026-10-23', '2026-10-24', '2026-10-25', D])
+    expect(rows.map(r => r.kcal)).toEqual([0, 500, 0, 700])
+  })
+
+  it('averages only the days with food logged', () => {
+    let N = addEntry(emptyNutrition(), '2026-10-24', { name: 'x', kcal: 2000, protein: 100 }, 'a')
+    N = addEntry(N, D, { name: 'y', kcal: 2400, protein: 131 }, 'b')
+    expect(averageLogged(recentDays(N, D, 7))).toEqual({ days: 2, kcal: 2200, protein: 115.5 })
+    expect(averageLogged(recentDays(emptyNutrition(), D, 7))).toBeNull()
+    // a day with only water is not a day of eating
+    expect(averageLogged(recentDays(addWater(emptyNutrition(), D, 500), D, 7))).toBeNull()
+  })
+})
+
+describe('bars and units', () => {
+  it('fills a bar up to 100 and flags going past the target', () => {
+    expect(barPct(1150, 2300)).toBe(50)
+    expect(barPct(5000, 2300)).toBe(100)
+    expect(barPct(-5, 2300)).toBe(0)
+    expect(barPct(10, 0)).toBe(0)
+    expect(overTarget(2301, 2300)).toBe(true)
+    expect(overTarget(2300, 2300)).toBe(false)
+    expect(overTarget(5, 0)).toBe(false)
+  })
+
+  it('writes litres with two decimals when it needs them', () => {
+    expect(fmtLiters(1250)).toBe('1.25')
+    expect(fmtLiters(2000)).toBe('2')
+    expect(fmtLiters(0)).toBe('0')
+  })
+})
+
+describe('backup', () => {
+  it('exports and imports the same data', () => {
+    let N = addEntry(emptyNutrition(), D, { name: 'Lentil soup', kcal: 180, protein: 11 }, 'a')
+    N = saveFood(setTargets(N, { kcal: 2200 }), { name: 'Egg', kcal: 78, protein: 6 }, 'f')
+    expect(importNutrition(exportNutrition(N))).toEqual(N)
+  })
+
+  it('throws on text that is not a backup, so nothing gets wiped', () => {
+    expect(() => importNutrition('not json')).toThrow()
+    expect(() => importNutrition('[]')).toThrow()
+    expect(() => importNutrition('null')).toThrow()
+  })
+
+  it('cleans an imported file instead of trusting it', () => {
+    const N = importNutrition(JSON.stringify({ targets: { kcal: -1 }, days: { [D]: { entries: [{ name: 'x'.repeat(200), kcal: 5 }] } } }))
+    expect(N.targets.kcal).toBe(800)
+    expect(N.days[D].entries[0].name).toHaveLength(60)
+  })
+})
